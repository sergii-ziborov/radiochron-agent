<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.radiochron.agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/radiochron-agent-update</string>
    <string>supervise</string>
    <string>--state-dir</string>
    <string>/Library/Application Support/RadioChron/spool/state/fleet</string>
    <string>--agent</string>
    <string>/usr/local/bin/radiochron-agent</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>RADIOCHRON_SPOOL_DIR</key>
    <string>/Library/Application Support/RadioChron/spool</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>5</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>/Library/Logs/RadioChron/agent.log</string>
  <key>StandardErrorPath</key>
  <string>/Library/Logs/RadioChron/agent-error.log</string>
</dict>
</plist>
